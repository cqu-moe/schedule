{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schedule-beta-cqu-moe",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,

  // Place Worker near CQU API server to reduce latency
  "placement": {
    "hostname": "my.cqu.edu.cn"
  },

  // Static Assets: Vue frontend build output
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // D1 Database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schedule-beta-cqu-moe-db",
      "database_id": "7e0899f3-8acf-4237-a7e5-89000e3841f0",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // KV Cache
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d50f0c7192594234ae41c3be939a108a"
    }
  ],

  // Service Bindings (拓扑①: RPC to cqu-moe-auth)
  // entrypoint 必须指向 auth 的具名 RPC 类 `AuthService extends WorkerEntrypoint`
  // （见 ../auth docs/plans/2026-06-14-firstparty-entitlements-plan.md C2）。auth
  // Worker 同时 export default(Hono HTTP) + named AuthService(RPC)；不指定
  // entrypoint 会绑到默认 HTTP 入口，verifySession/getCquTicket 等 RPC 不可用。
  "services": [
    { "binding": "AUTH", "service": "cqu-moe-auth", "entrypoint": "AuthService" }
  ],

  // Rate Limiting
  "ratelimits": [
    {
      "name": "UNAUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 40, "period": 60 }
    },
    {
      "name": "EXTERNAL_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Queues
  "queues": {
    "producers": [
      { "binding": "SCHEDULE_SYNC_QUEUE", "queue": "schedule-sync" },
      { "binding": "SCHEDULE_NOTIFICATION_QUEUE", "queue": "schedule-notifications" }
    ],
    "consumers": [
      {
        "queue": "schedule-sync",
        "max_batch_size": 5,
        // 45 给容量等待分支(BROWSER_BUSY)留出空间:60-90s 退避、
        // 同一 syncRun 最多等 45 分钟/45 次。普通失败仍由代码限定 [30,120,300] 共 3 次,
        // 平台上限扩大不改变这个规则。batch=5、consumer concurrency=1 保持不变。
        "max_retries": 45,
        "max_concurrency": 1,
        "max_batch_timeout": 30
      }
    ]
  },

  // Environment Variables
  "vars": {
    "PUBLIC_URL": "https://schedule.cqu.moe"
  },

  // Observability (Workers Logs & Traces)
  "observability": {
    "enabled": true,
    // TODO: 用户量上来后考虑降低 traces 采样率以控制成本
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  // Custom Domains
  "routes": [
    { "pattern": "schedule-beta.cqu.moe", "custom_domain": true },
    { "pattern": "schedule.cqu.moe", "custom_domain": true }
  ],

  // Cron Triggers
  // "0 * * * *" 每小时挑选到期订阅入队 schedule-sync（按各用户 caps.sync_interval 档位）。
  // 修改此表达式时须同步 src/index.ts scheduled switch 的 case（见 CLAUDE.md）。
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
