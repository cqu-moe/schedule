{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schedule-beta-cqu-moe",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-25",
  "compatibility_flags": ["nodejs_compat"],

  // Place Worker near CQU API server to reduce latency
  "placement": {
    "hostname": "my.cqu.edu.cn"
  },

  // Static Assets: Vue frontend build output
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // D1 Database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schedule-beta-cqu-moe-db",
      "database_id": "7e0899f3-8acf-4237-a7e5-89000e3841f0",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // KV Cache
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d50f0c7192594234ae41c3be939a108a"
    }
  ],

  // Rate Limiting
  "ratelimits": [
    {
      "name": "UNAUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "EXPLORE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Queues
  "queues": {
    "producers": [
      { "binding": "TOKEN_REFRESH_QUEUE", "queue": "schedule-token-refresh" },
      { "binding": "SCHEDULE_SYNC_QUEUE", "queue": "schedule-sync" }
    ],
    "consumers": [
      {
        "queue": "schedule-token-refresh",
        "max_batch_size": 20,
        "max_retries": 3,
        "max_concurrency": 5,
        "max_batch_timeout": 30
      },
      {
        "queue": "schedule-sync",
        "max_batch_size": 10,
        "max_retries": 3,
        "max_concurrency": 3,
        "max_batch_timeout": 30
      }
    ]
  },

  // Environment Variables
  "vars": {
    "PUBLIC_URL": "https://schedule.cqu.moe",
    "HCAPTCHA_ENABLED": "false",
    "HCAPTCHA_SITEKEY": "66748454-bd4e-4ca8-a6f0-42066aca8f22",
    "MAX_SUBSCRIPTIONS": "10"
  },

  // Observability (Workers Logs & Traces)
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  // Custom Domains
  "routes": [
    { "pattern": "schedule-beta.cqu.moe", "custom_domain": true },
    { "pattern": "schedule.cqu.moe", "custom_domain": true }
  ],

  // Cron Triggers
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 19 * * *"
    ]
  }
}
