{
  "name": "schedule-cloudflare",
  "version": "1.0.0",
  "private": true,
  "description": "CQU schedule subscription service on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply schedule-db --local"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.1.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.17",
    "@cloudflare/workers-types": "^4.20260304.0",
    "@types/node": "^25.3.1",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.68.1"
  }
}
